# Application Configuration
APP_NAME="TadbeerGo"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=personal_life_management
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session & Security
SESSION_LIFETIME=86400
SESSION_SECURE=false
CSRF_SECRET=your_random_csrf_secret_key_change_in_production
CRON_SECRET=secure_cron_token_for_scheduled_tasks

# Timezone
APP_TIMEZONE=Asia/Dhaka
